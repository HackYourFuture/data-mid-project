# Required environment variables for the pipeline.
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to git.
#
# Fetch the values from Azure Key Vault (run once, then paste below):
#
#   export POSTGRES_URL="$(az keyvault secret show --vault-name kv-hyf-data --name postgres-url --query value -o tsv)"
#   export AZURE_STORAGE_CONNECTION_STRING="$(az keyvault secret show --vault-name kv-hyf-data --name storage-connection-string --query value -o tsv)"
#
# Or inject them directly when running the container locally:
#
#   docker run \
#     -e POSTGRES_URL="$(az keyvault secret show --vault-name kv-hyf-data --name postgres-url --query value -o tsv)" \
#     -e AZURE_STORAGE_CONNECTION_STRING="$(az keyvault secret show --vault-name kv-hyf-data --name storage-connection-string --query value -o tsv)" \
#     -e LOG_LEVEL=INFO \
#     my-pipeline

POSTGRES_URL=
AZURE_STORAGE_CONNECTION_STRING=
LOG_LEVEL=INFO
